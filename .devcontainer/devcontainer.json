{
  "name": "Commentometre API",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [
    7860
  ],
  "portsAttributes": {
    "7860": {
      "label": "API Commentometre",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pip install -r requirements-prod.txt",
  "postStartCommand": "bash .devcontainer/start_api.sh"
}
